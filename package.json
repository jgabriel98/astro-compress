{
  "name": "gab-astro-compress",
  "keywords": [
    "compress",
    "astro",
    "astro-compress",
    "withastro",
    "astro-integration",
    "performance",
    "tooling"
  ],
  "version": "0.1.2",
  "description": "Compression integration for static assets in astro, with caching.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jgabriel98/astro-compress.git"
  },
  "homepage": "https://github.com/jgabriel98/astro-compress#readme",
  "bugs": {
    "url": "https://github.com/jgabriel98/astro-compress/issues"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    "import": "./dist/index.mjs",
    "require": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "author": "João Gabriel S. Fernandes <jgabsfernandes@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "^4.0.15",
    "astro": "^7.0.3",
    "prettier": "^3.8.4",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "browserslist": "^4.28.4",
    "chalk": "^5.6.2",
    "html-minifier-terser": "^7.2.0",
    "lightningcss": "^1.32.0",
    "sharp": "^0.34.5",
    "svgo": "^4.0.1",
    "terser": "^5.48.0"
  }
}
